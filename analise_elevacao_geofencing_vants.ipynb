import sys
import scipy
import sklearn
import numpy as np
import pandas as pd
import scipy.stats as stats
import seaborn as sns
import matplotlib.pyplot as plt
from ucimlrepo import fetch_ucirepo
from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier, export_text
from sklearn.metrics import accuracy_score, classification_report
pd.set_option('display.max_columns', None)
pd.set_option('display.width', 1000)

# Carregamento dos dados
dataset = fetch_ucirepo(id=31)
df = pd.concat([dataset.data.features, dataset.data.targets], axis=1)

mapa_florestas = {
    1: "1 - Spruce/Fir",
    2: "2 - Lodgepole Pine",
    3: "3 - Ponderosa Pine",
    4: "4 - Cottonwood/Willow",
    5: "5 - Aspen",
    6: "6 - Douglas-fir",
    7: "7 - Krummholz"
}
df['Classe_Florestal'] = df['Cover_Type'].map(mapa_florestas)

# estatistica descritiva por classe
print("\nESTATÍSTICA DESCRITIVA DA ELEVAÇÃO POR COBERTURA FLORESTAL (em metros)")

resumo_estatistico = df.groupby('Classe_Florestal')['Elevation'].agg(
    Amostras='count',
    Percentual=lambda x: (len(x) / len(df)) * 100,
    Media='mean',
    Desvio_Padrao='std',
    Minimo='min',
    Mediana='median',
    Maximo='max'
).round(2)

print(resumo_estatistico)

grupos = [df[df['Cover_Type'] == i]['Elevation'].values for i in range(1, 8)]
nomes_curtos = [mapa_florestas[i] for i in range(1, 8)]

# teste de Levene
print("\nTESTE DE LEVENE")
levene_stat, levene_p = stats.levene(*grupos)
print(f"Estatística de Levene : {levene_stat:,.2f}".replace(",", "X").replace(".", ",").replace("X", "."))
print(f"Valor-p (Levene)      : {levene_p:.2e}")
if levene_p < 0.05:
    print("Diagnóstico           : Variâncias heterogêneas.")
else:
    print("Diagnóstico           : Variâncias homogêneas.")

print("\nTESTES INFERENCIAIS E TAMANHO DE EFEITO")
# ANOVA Clássica
f_stat, p_value = stats.f_oneway(*grupos)

# eta-quadrado
media_geral = df['Elevation'].mean()
ss_total = np.sum((df['Elevation'].values - media_geral) ** 2)
ss_entre = sum(len(g) * (np.mean(g) - media_geral) ** 2 for g in grupos)
eta_quadrado = ss_entre / ss_total

# ANOVA de Welch
k = len(grupos)
ni = np.array([len(g) for g in grupos], dtype=float)
vi = np.array([np.var(g, ddof=1) for g in grupos], dtype=float)
mi = np.array([np.mean(g) for g in grupos], dtype=float)

wi = ni / vi
w_sum = np.sum(wi)
x_welch = np.sum(wi * mi) / w_sum

termo_erro = np.sum(((1.0 - (wi / w_sum)) ** 2) / (ni - 1.0))
f_welch = (np.sum(wi * ((mi - x_welch) ** 2)) / (k - 1.0)) / (1.0 + (2.0 * (k - 2.0) / (k**2 - 1.0)) * termo_erro)
df1_welch = k - 1.0
df2_welch = (k**2 - 1.0) / (3.0 * termo_erro)
p_welch = stats.f.sf(f_welch, df1_welch, df2_welch)

print(f"Total de instâncias (N)        : {len(df):,}".replace(",", "."))
print(f"ANOVA Clássica - Estatística F : {f_stat:,.2f}".replace(",", "X").replace(".", ",").replace("X", "."))
print(f"ANOVA Clássica - Valor-p       : {p_value:.2e}")
print(f"ANOVA de Welch - Estatística F : {f_welch:,.2f}".replace(",", "X").replace(".", ",").replace("X", "."))
print(f"ANOVA de Welch - Valor-p       : {p_welch:.2e}")
print(f"Tamanho de Efeito (Eta² / η²)  : {eta_quadrado:.4f} ({eta_quadrado*100:.2f}% da variância explicada)")

# post-hoc gomes-howelll
print("\nPOST-HOC GAMES-HOWELL")
pares_nao_sig = []

for i in range(k):
  for j in range(i + 1, k):
      diff = abs(mi[i] - mi[j])
      se = np.sqrt((vi[i] / ni[i]) + (vi[j] / ni[j]))
      t_stat = diff / se
      df_gh = ((vi[i] / ni[i]) + (vi[j] / ni[j])) ** 2 / (
          ((vi[i] / ni[i]) ** 2 / (ni[i] - 1.0)) + ((vi[j] / ni[j]) ** 2 / (ni[j] - 1.0)))
      q_crit = stats.studentized_range.ppf(0.95, k, df_gh)
      t_crit = q_crit / np.sqrt(2.0)
      p_gh = stats.studentized_range.sf(t_stat * np.sqrt(2.0), k, df_gh)
      ci_low = diff - t_crit * se
      ci_high = diff + t_crit * se

      if i == 2 and j == 5:
        print(f"Par analisado {nomes_curtos[i]} vs. {nomes_curtos[j]}")
        print(f"Diferença entre médias  : {diff:.2f} m (IC 95%: [{ci_low:.2f} m, {ci_high:.2f} m])")
        print(f"Valor-p ajustado        : {p_gh:.2e}")

      if p_gh >= 0.05:
        pares_nao_sig.append((nomes_curtos[i], nomes_curtos[j], p_gh))

if not pares_nao_sig:
  print(f"Resultado        : Todos os 21 pares de classes diferentes estatisticamente (p < 0,001).")
else:
  print(f"Pares sem diferença significativa:", pares_nao_sig)

print(f"AVALIAÇÃO DE SEPARABILIDADE / CLASSIFICAÇÃO POR ELEVAÇÃO")
x = df[['Elevation']]
y = df['Cover_Type']

X_train, X_test, y_train, y_test = train_test_split(x, y, test_size=0.3, random_state=42, stratify=y)

clf = DecisionTreeClassifier(max_depth=3, random_state=42)
clf.fit(X_train, y_train)
y_pred = clf.predict(X_test)

acc = accuracy_score(y_test, y_pred) * 100
print(f"Acurácia do modelo: {acc:.2f}%")
print(f"Regras de limiares altimétricos:")
print(export_text(clf, feature_names=['Elevation']))
print(classification_report(y_test, y_pred, target_names=nomes_curtos, zero_division=0))

# grafico boxplot
sns.set_theme(style="whitegrid", context="paper", font_scale=1.2)
plt.rcParams['font.family'] = 'sans-serif'

fig, ax = plt.subplots(figsize=(11, 6), dpi=300)

sns.boxplot(
    data=df,
    x='Cover_Type',
    y='Elevation',
    hue='Cover_Type',
    palette='crest',
    width=0.55,
    linewidth=1.2,
    legend=False,
    showmeans=True,
    meanprops={
        "marker": "D",
        "markerfacecolor": "white",
        "markeredgecolor": "#1a1a1a",
        "markersize": 5
    },
    flierprops={
        "marker": "o",
        "markersize": 2,
        "alpha": 0.25,
        "markerfacecolor": "#4a4a4a",
        "markeredgecolor": "none"
    },
    ax=ax
)

ax.set_xticks(range(7))
ax.set_xticklabels(nomes_curtos, rotation=22, ha='right', fontsize=10.5)
ax.set_title(
    'Distribuição Altimétrica por Tipo de Cobertura Florestal',
    fontsize=13,
    fontweight='bold',
    pad=15
)
ax.set_xlabel('Classe de Cobertura Florestal (Cover_Type)', fontsize=11.5, labelpad=10)
ax.set_ylabel('Elevação (metros acima do nível do mar)', fontsize=11.5, labelpad=10)

sns.despine(top=True, right=True)
ax.grid(axis='y', linestyle='--', alpha=0.5)
ax.grid(axis='x', visible=False)

nome_arquivo = 'boxplot_elevacao_covertype.png'
plt.tight_layout()
plt.savefig(nome_arquivo, dpi=300, bbox_inches='tight')
plt.show()

try:
    from google.colab import files
    files.download(nome_arquivo)
except ImportError:
    pass
